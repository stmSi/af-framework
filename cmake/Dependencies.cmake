function(af_framework_dependency_alias alias target)
    get_target_property(actual_target "${target}" ALIASED_TARGET)
    if(NOT actual_target)
        set(actual_target "${target}")
    endif()
    add_library(${alias} ALIAS ${actual_target})
endfunction()


if(EXISTS "${AF_FRAMEWORK_DEPENDENCY_ROOT}/freetype/CMakeLists.txt" AND
   EXISTS "${AF_FRAMEWORK_DEPENDENCY_ROOT}/harfbuzz/CMakeLists.txt")
    if(NOT TARGET freetype)
        set(BUILD_SHARED_LIBS OFF CACHE BOOL "" FORCE)
        set(FT_DISABLE_ZLIB ON CACHE BOOL "" FORCE)
        set(FT_DISABLE_BZIP2 ON CACHE BOOL "" FORCE)
        set(FT_DISABLE_PNG ON CACHE BOOL "" FORCE)
        set(FT_DISABLE_HARFBUZZ ON CACHE BOOL "" FORCE)
        set(FT_DISABLE_BROTLI ON CACHE BOOL "" FORCE)
        add_subdirectory("${AF_FRAMEWORK_DEPENDENCY_ROOT}/freetype"
            "${AF_FRAMEWORK_DEPENDENCY_BINARY_DIR}/freetype" EXCLUDE_FROM_ALL)
    endif()
    if(NOT TARGET harfbuzz)
        set(HB_BUILD_UTILS OFF CACHE BOOL "" FORCE)
        set(HB_BUILD_SUBSET OFF CACHE BOOL "" FORCE)
        set(HB_HAVE_FREETYPE ON CACHE BOOL "" FORCE)
        add_subdirectory("${AF_FRAMEWORK_DEPENDENCY_ROOT}/harfbuzz"
            "${AF_FRAMEWORK_DEPENDENCY_BINARY_DIR}/harfbuzz" EXCLUDE_FROM_ALL)
    endif()
else()
    find_package(Freetype REQUIRED)
    if(NOT TARGET freetype)
        af_framework_dependency_alias(freetype Freetype::Freetype)
    endif()
    find_package(harfbuzz CONFIG QUIET)
    if(NOT TARGET harfbuzz::harfbuzz)
        find_package(PkgConfig REQUIRED)
        pkg_check_modules(AF_FRAMEWORK_HARFBUZZ REQUIRED IMPORTED_TARGET harfbuzz)
        add_library(harfbuzz::harfbuzz ALIAS PkgConfig::AF_FRAMEWORK_HARFBUZZ)
    endif()
    if(NOT TARGET harfbuzz)
        af_framework_dependency_alias(harfbuzz harfbuzz::harfbuzz)
    endif()
endif()

if(AF_FRAMEWORK_BUILD_PLATFORM AND NOT TARGET SDL3::SDL3-static)
    if(EXISTS "${AF_FRAMEWORK_DEPENDENCY_ROOT}/SDL/CMakeLists.txt")
        set(SDL_SHARED OFF CACHE BOOL "" FORCE)
        set(SDL_STATIC ON CACHE BOOL "" FORCE)
        set(SDL_TEST_LIBRARY OFF CACHE BOOL "" FORCE)
        set(SDL_TESTS OFF CACHE BOOL "" FORCE)
        set(SDL_EXAMPLES OFF CACHE BOOL "" FORCE)
        set(SDL_INSTALL OFF CACHE BOOL "" FORCE)
        foreach(subsystem AUDIO CAMERA GPU RENDER JOYSTICK HAPTIC SENSOR POWER TRAY WAYLAND)
            set(SDL_${subsystem} OFF CACHE BOOL "" FORCE)
        endforeach()
        set(SDL_DIALOG ON CACHE BOOL "" FORCE)
        set(AF_FRAMEWORK_SAVED_C_EXTENSIONS "${CMAKE_C_EXTENSIONS}")
        set(AF_FRAMEWORK_SAVED_DEFINITIONS "${CMAKE_REQUIRED_DEFINITIONS}")
        set(CMAKE_C_EXTENSIONS ON)
        if(CMAKE_SYSTEM_NAME STREQUAL "Linux")
            set(CMAKE_REQUIRED_DEFINITIONS -D_GNU_SOURCE)
        endif()
        add_subdirectory("${AF_FRAMEWORK_DEPENDENCY_ROOT}/SDL"
            "${AF_FRAMEWORK_DEPENDENCY_BINARY_DIR}/SDL" EXCLUDE_FROM_ALL)
        set(CMAKE_C_EXTENSIONS "${AF_FRAMEWORK_SAVED_C_EXTENSIONS}")
        set(CMAKE_REQUIRED_DEFINITIONS "${AF_FRAMEWORK_SAVED_DEFINITIONS}")
    else()
        find_package(SDL3 CONFIG REQUIRED)
        if(NOT TARGET SDL3::SDL3-static)
            af_framework_dependency_alias(SDL3::SDL3-static SDL3::SDL3)
        endif()
    endif()
endif()

if(AF_FRAMEWORK_BUILD_VULKAN)
    if(EXISTS "${AF_FRAMEWORK_DEPENDENCY_ROOT}/Vulkan-Headers/include/vulkan/vulkan.h")
        set(AF_FRAMEWORK_VULKAN_INCLUDE_DIR "${AF_FRAMEWORK_DEPENDENCY_ROOT}/Vulkan-Headers/include")
    else()
        find_path(AF_FRAMEWORK_VULKAN_INCLUDE_DIR vulkan/vulkan.h REQUIRED)
    endif()
    if(EXISTS "${AF_FRAMEWORK_DEPENDENCY_ROOT}/volk/volk.c")
        set(AF_FRAMEWORK_VOLK_SOURCE "${AF_FRAMEWORK_DEPENDENCY_ROOT}/volk/volk.c")
        set(AF_FRAMEWORK_VOLK_INCLUDE_DIR "${AF_FRAMEWORK_DEPENDENCY_ROOT}/volk")
    else()
        find_path(AF_FRAMEWORK_VOLK_INCLUDE_DIR volk.h REQUIRED)
        find_file(AF_FRAMEWORK_VOLK_SOURCE volk.c
            HINTS "${AF_FRAMEWORK_VOLK_INCLUDE_DIR}" REQUIRED)
    endif()
endif()
