@PACKAGE_INIT@
set(AFFramework_INSTALL_PREFIX "${PACKAGE_PREFIX_DIR}")
include(CMakeFindDependencyMacro)
if(NOT TARGET Freetype::Freetype)
    find_dependency(Freetype)
endif()
if(NOT TARGET AFFramework::Freetype)
    add_library(AFFramework::Freetype INTERFACE IMPORTED)
    set_target_properties(AFFramework::Freetype PROPERTIES INTERFACE_LINK_LIBRARIES Freetype::Freetype)
endif()
if(NOT TARGET harfbuzz::harfbuzz)
    find_package(harfbuzz CONFIG QUIET)
    if(NOT TARGET harfbuzz::harfbuzz)
        find_dependency(PkgConfig)
        pkg_check_modules(AF_FRAMEWORK_HARFBUZZ REQUIRED IMPORTED_TARGET harfbuzz)
        add_library(harfbuzz::harfbuzz ALIAS PkgConfig::AF_FRAMEWORK_HARFBUZZ)
    endif()
endif()
if(NOT TARGET AFFramework::HarfBuzz)
    add_library(AFFramework::HarfBuzz INTERFACE IMPORTED)
    set_target_properties(AFFramework::HarfBuzz PROPERTIES INTERFACE_LINK_LIBRARIES harfbuzz::harfbuzz)
endif()
if(@AF_FRAMEWORK_BUILD_PLATFORM@)
    find_dependency(SDL3 CONFIG)
    if(NOT TARGET AFFramework::SDL3)
        add_library(AFFramework::SDL3 INTERFACE IMPORTED)
        set_target_properties(AFFramework::SDL3 PROPERTIES INTERFACE_LINK_LIBRARIES SDL3::SDL3)
    endif()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/AFFrameworkTargets.cmake")
set(AFFramework_SHADER_DIRECTORY "${AFFramework_INSTALL_PREFIX}/@CMAKE_INSTALL_DATADIR@/af-framework/shaders")
check_required_components(AFFramework)
